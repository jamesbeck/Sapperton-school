# Public Cloudflare Turnstile widget key (safe to expose in the browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Private Cloudflare Turnstile widget secret (server-only; never commit a value)
TURNSTILE_SECRET_KEY=

# Optional comma-separated override for token hostname validation
TURNSTILE_ALLOWED_HOSTNAMES=sappertonschool.org,www.sappertonschool.org,sapperton-school.vercel.app
